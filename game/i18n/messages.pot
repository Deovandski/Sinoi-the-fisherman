#. data/fight_modes.json: slide_guide.name
msgid "Slide Guide"
msgstr ""

#. data/fight_modes.json: slide_guide.hint
msgid "Keep your finger on the moving ring. Watch the top box, play in the bottom one."
msgstr ""

#. data/fight_modes.json: shake_rub.name
msgid "Shake"
msgstr ""

#. data/fight_modes.json: shake_rub.hint
msgid "Shake the phone on SHAKE, hold still on STILL. No motion sensor? Rub the bottom box back and forth instead."
msgstr ""

#. data/fight_modes.json: tap_tempo.name
msgid "Tap Tempo"
msgstr ""

#. data/fight_modes.json: tap_tempo.hint
msgid "Tap anywhere in the bottom box. Follow the cue: steady beat, faster, slower, or the rhythm shown."
msgstr ""

#. data/fight_modes.json: reel_spin.name
msgid "Reel Spin"
msgstr ""

#. data/fight_modes.json: reel_spin.hint
msgid "Circle your finger clockwise to reel. When the fish runs, ease off or the line snaps."
msgstr ""

#. data/fight_modes.json: flick_hookset.name
msgid "Hookset"
msgstr ""

#. data/fight_modes.json: flick_hookset.hint
msgid "When the ring closes, flick the way the arrow points. On an X, don't flick."
msgstr ""

#. data/fight_modes.json: hold_hop.name
msgid "Hold Hop"
msgstr ""

#. data/fight_modes.json: hold_hop.hint
msgid "Press the small spot when the ring closes, hold until it fills, lift on LIFT. Timing costs more than aim."
msgstr ""

#. data/fight_modes.json: lost_ref.name
msgid "Lost Ref"
msgstr ""

#. data/fight_modes.json: lost_ref.hint
msgid "Slide Guide, but the bottom box sometimes goes out. When it turns red, play in the top box. When the arrow points down, go back."
msgstr ""

#. data/fight_modes.json: beat_notes.name
msgid "Beat Notes"
msgstr ""

#. data/fight_modes.json: beat_notes.hint
msgid "Tap each circle as its ring closes, in number order. Drag circles: hold and follow the ball."
msgstr ""

#. data/fight_modes.json: twin_drift.name
msgid "Twin Drift"
msgstr ""

#. data/fight_modes.json: twin_drift.hint
msgid "Index and middle finger: keep one on each square. They drift at different speeds."
msgstr ""

